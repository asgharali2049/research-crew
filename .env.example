# OpenAI Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here

# Optional: Specify model (default: gpt-4o)
# Options: gpt-4o, gpt-4-turbo, gpt-3.5-turbo, etc.
# OPENAI_MODEL=gpt-4o

# Optional: API base URL (for self-hosted or alternative providers)
# API_BASE=https://api.openai.com/v1

# Optional: Logging level
# Options: DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO

# Optional: Output directory for reports
# OUTPUT_DIR=./reports

# Optional: Request timeout (seconds)
# REQUEST_TIMEOUT=30

# For local LLM (e.g., Ollama)
# Uncomment and configure if using local models
# MODEL=ollama/deepseek-v3.1
# API_BASE=http://localhost:11434
